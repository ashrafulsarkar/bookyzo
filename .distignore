# Files and folders that must never ship in the WordPress.org release.
# Read by bin/build-release.js (the local zip) and by the GitHub deploy
# workflow (.github/workflows/deploy.yml), which hands it to rsync. A
# leading "/" anchors a pattern to the plugin root — without it rsync
# would also drop any nested folder of the same name.
/.git
/.gitignore
/.gitattributes
/.github
/.distignore
/.editorconfig
/.claude
/.dev-server-running
# WordPress.org banners, icons and screenshots go to the SVN assets/
# folder, not into the plugin.
/.wordpress-org
/DETAILED-SPEC.md
/ROADMAP.md
/FEATURES.md
/README.md
/bin
/node_modules
/release
/scratchpad
*.zip
*.log
# Local QA notes, never shipped.
BOOKYZO-QA-REPORT-*.md
# Vue source and the build setup. The repository is public, so
# readme.txt's FAQ links to it for the source of the minified bundles in
# assets/ (WordPress.org Guideline 4) instead of shipping it.
/src
/package.json
/package-lock.json
/vite.config.js
/vite.widget.config.js
/vite.account.config.js
/vite.translator-comments.js
/tailwind.config.js
/postcss.config.js
/jsconfig.json
/components.json
